<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/BusitionLogin">

    <fragment
        android:id="@+id/BusitionLogin"
        android:name="com.busition.driver.ui.login.LoginFragment"
        android:label="@string/Login_Fragment_Label"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_Register_to_Login_Fragment"
            app:destination="@id/BusitionRegister" />
    </fragment>
    <fragment
        android:id="@+id/BusitionRegister"
        android:name="com.busition.driver.ui.login.RegistFragment"
        android:label="@string/Register_Fragment_Label"
        tools:layout="@layout/fragment_regist">


        <action
            android:id="@+id/action_BusitionRegister_to_BusitionLogin"
            app:destination="@id/BusitionLogin" />
    </fragment>
</navigation>