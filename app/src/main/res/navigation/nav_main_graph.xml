<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main_graph"
    app:startDestination="@id/scheduleList">
    <fragment
        android:id="@+id/scheduleList"
        android:name="io.busition.driver.main_screen.fragment.ScheduleList"
        android:label="스케줄"
        tools:layout="@layout/fragment_schedule_list" >
        <action
            android:id="@+id/action_scheduleList_to_bus_start_main_screen"
            app:destination="@id/bus_start_main_screen" />

    </fragment>
    <fragment
        android:id="@+id/bus_start_main_screen"
        android:name="io.busition.driver.main_screen.fragment.BusStartMainScreen"
        android:label="운행중"
        tools:layout="@layout/bus_start_main_screen" >
        <action
            android:id="@+id/action_fragment_item_detial_screen_to_userInfoDataFragment"
            app:destination="@id/userInfoDataFragment" />
    </fragment>
    <fragment
        android:id="@+id/userInfoDataFragment"
        android:name="io.busition.driver.main_screen.fragment.UserInfoDataFragment"
        android:label="탑승자 목록"
        tools:layout="@layout/fragment_user_info_item_list" >
        <action
            android:id="@+id/action_userInfoDataFragment_to_fragment_item_detial_screen"
            app:destination="@id/bus_start_main_screen" />
    </fragment>
</navigation>