<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
             xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_main_graph"
    app:startDestination="@id/scheduleList">
    <fragment
        android:id="@+id/scheduleList"
        android:name="com.example.busition_driver.main_screen.ScheduleList"
        android:label="Schedule"
        tools:layout="@layout/fragment_schedule_list" >
        <action
            android:id="@+id/action_scheduleList_to_fragment_item_detial_screen"
            app:destination="@id/fragment_item_detial_screen" />

    </fragment>
    <fragment
        android:id="@+id/fragment_item_detial_screen"
        android:name="com.example.busition_driver.main_screen.FragmentItemDetailScreen"
        android:label="Item Detail"
        tools:layout="@layout/fragment_item_detail_screen" >
        <action
            android:id="@+id/action_fragment_item_detial_screen_to_fragment_station_item_screen"
            app:destination="@id/fragment_station_item_screen" />
    </fragment>
    <fragment
        android:id="@+id/fragment_station_item_screen"
        android:name="com.example.busition_driver.StationDetailFragment"
        android:label="Station Detail"
        tools:layout="@layout/fragment_station_item_screen">
        <action
            android:id="@+id/action_fragment_station_item_screen_to_userInfoDataFragment"
            app:destination="@id/userInfoDataFragment" />
    </fragment>
    <fragment
        android:id="@+id/userInfoDataFragment"
        android:name="com.example.busition_driver.UserInfoDataFragment"
        android:label="fragment_user_info_item_list"
        tools:layout="@layout/fragment_user_info_item_list" />
</navigation>